# Front (expostas ao navegador — NUNCA colocar segredo aqui).
# A anon key e publica por design; o isolamento vem da RLS, nao do sigilo da chave.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# App da Meta. So o ID e publico; o secret vive no servidor.
VITE_META_APP_ID=
VITE_META_OAUTH_URL=https://www.facebook.com/v21.0/dialog/oauth
# Em producao, o dominio do Cloudflare Pages (ADR-010). Se ficar com o de
# localhost apos o deploy, a Meta recusa o redirect_uri e a conexao morre no
# proprio dialogo — sem erro no build.
VITE_META_REDIRECT_URI=http://localhost:5173/conectar/retorno

# ── Somente servidor (Edge Functions). Nunca prefixar com VITE_. ──
# Configurar com `supabase secrets set`, jamais neste arquivo em producao.
# META_APP_ID e META_APP_SECRET sao usados por `conectar-conta` E por
# `coleta-diaria`: a coleta renova o token da Meta a 15 dias do vencimento
# (ADR-009), e sem estas duas a renovacao falha em silencio.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# SUPABASE_SERVICE_ROLE_KEY=
#
# As duas listas abaixo passam a valer o dominio de producao no deploy. Nenhuma
# falha no build: as duas falham em uso, depois (ADR-010).
# KORA_REDIRECIONAMENTOS_PERMITIDOS: sem o dominio novo, `conectar-conta` recusa
#   com ENTRADA_INVALIDA mesmo com a Meta tendo aprovado o consentimento.
# KORA_ORIGENS_PERMITIDAS: sem ele, o CORS nao ecoa a origem e TODA chamada do
#   navegador as Edge Functions falha — nao uma tela, todas.
# KORA_REDIRECIONAMENTOS_PERMITIDOS=https://SEU-DOMINIO/conectar/retorno
# KORA_ORIGENS_PERMITIDAS=https://SEU-DOMINIO
