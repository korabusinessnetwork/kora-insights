# Front (expostas ao navegador — NUNCA colocar segredo aqui).
# A anon key e publica por design; o isolamento vem da RLS, nao do sigilo da chave.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# App da Meta. So o ID e publico; o secret vive no servidor.
VITE_META_APP_ID=
VITE_META_REDIRECT_URI=http://localhost:5173/conectar/retorno

# ── Somente servidor (Edge Functions). Nunca prefixar com VITE_. ──
# Configurar com `supabase secrets set`, jamais neste arquivo em producao.
# META_APP_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
